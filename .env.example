# ============================================================
# Docker Compose 环境变量模板
# ============================================================
# 用法：
#   cp .env.example .env      （.env 已被 .gitignore 忽略，不会提交）
#   填写下面的值，然后 docker compose up -d --build
#
# 注意别和下面这个搞混：
#   本文件是 docker compose 用的；
#   前端本地开发（vite dev server）用的令牌模板是 frontend/.env.example。
# ============================================================

# ---------- MySQL ----------
# root 密码。留空会直接报错中止（有意为之：静默用空密码起库比启动失败危险）
DB_PASSWORD=

# 宿主机映射端口。默认 3307 是为了避让本机已装的 MySQL（占用 3306）
MYSQL_HOST_PORT=3307

# ---------- 后端 ----------
# 宿主机映射端口。若本地 IDEA 正跑着 8080，改成 18080 之类
BACKEND_HOST_PORT=8080

# 鉴权总开关。本地可设 false 图省事，UAT/生产必须为 true
APP_AUTH_ENABLED=true

# 四个令牌。未填写的账号会被后端自动跳过（不会变成"空令牌即可通过"）
# 至少配一个，否则没有任何有效令牌，所有 /api/** 一律 401
APP_TOKEN_RISK_ADMIN=
APP_TOKEN_RISK_APPROVER=
APP_TOKEN_API_CLIENT=
APP_TOKEN_SYS_ADMIN=

# ---------- 前端 ----------
FRONTEND_HOST_PORT=8081

# 可选：前端页面用哪个身份的令牌调后端。
# 不填则复用 APP_TOKEN_RISK_ADMIN
# FRONTEND_API_TOKEN=
